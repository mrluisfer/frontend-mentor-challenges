---
import { ChevronLeft } from "lucide-react";
import PageTitle from "../PageTitle";
import ChallengeNavigation from "./ChallengeNavigation";
import { challengesInitialState } from "@/constants/challenges";

interface Props {
	challengeName: string;
}

const { challengeName } = Astro.props;

const formattedChallengeName =
	challengesInitialState.find((challenge) => challenge.slug === challengeName)?.title ??
	challengeName.replace(/-/g, " ");
---

<header
	class="flex flex-wrap items-center justify-between gap-3 px-4 py-4 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-6"
	aria-label="Challenge header"
>
	<a
		href="/"
		aria-label="Back to home"
		class="focus-visible:ring-ring group flex shrink-0 items-center gap-1 rounded-md p-1 transition-colors hover:bg-neutral-100 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none dark:hover:bg-neutral-900"
	>
		<ChevronLeft
			size={20}
			strokeWidth={2}
			aria-hidden="true"
			className="transition-transform group-hover:-translate-x-0.5"
		/>
		<span class="text-lg font-extrabold sm:text-2xl">
			<PageTitle />
		</span>
	</a>
	<h1
		class="order-last min-w-0 flex-1 basis-full truncate text-center text-base font-semibold sm:order-none sm:basis-auto sm:text-lg md:text-xl"
		title={formattedChallengeName}
	>
		{formattedChallengeName}
	</h1>

	<div class="shrink-0">
		<ChallengeNavigation challengeName={challengeName} client:only />
	</div>
</header>
